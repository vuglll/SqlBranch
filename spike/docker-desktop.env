# Point the spike scripts at Docker Desktop instead of Colima (gate G3).
# Usage: source docker-desktop.env    (in the shell where you run 01-pool-docker-desktop.sh and 02 to 07)
export DOCKER_CONTEXT=desktop-linux
export ENGINE=sqlbranch-spike-dd
export PORT=14331
export POOL_MNT=/var/lib/sqlbranch/pool
